@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

@{
    var rol = HttpContextAccessor.HttpContext?
        .Session.GetString("Rol");

    var usuario = HttpContextAccessor.HttpContext?
        .Session.GetString("Usuario");

    var autenticado = !string.IsNullOrWhiteSpace(usuario);
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>
        @(ViewData["Title"] ?? "Rosea Skincare")
    </title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="~/css/rosea.css"
          asp-append-version="true" />

    @await RenderSectionAsync(
        "Styles",
        required: false
    )
</head>

<body class="d-flex flex-column min-vh-100">
    <div id="google_translate_element"></div>

    <main class="flex-grow-1">
        @RenderBody()
    </main>

    <script>
            window.ROSEA_SESSION = {
                isAuthenticated:
                    @Json.Serialize(autenticado),

                user:
                    @Json.Serialize(usuario),

                role:
                    @Json.Serialize(rol)
            };
    </script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js">
    </script>

    <script src="~/js/logging.js"></script>

    @await RenderSectionAsync(
        "Scripts",
        required: false
    )
</body>
</html>